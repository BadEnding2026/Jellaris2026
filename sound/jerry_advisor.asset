        weighted_sound = { sound = advisor_sample_vo_07 weight = 800 }
        weighted_sound = { sound = advisor_sample_vo_08 weight = 800 }
    }
    volume = 0.3
    max_audible = 1
    max_audible_behaviour = fail
}
